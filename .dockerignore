# The Linux release Dockerfile builds the JUCE LinuxMakefile exporter. Keep host
# IDE products and generated build outputs out of the Docker Desktop context,
# while retaining the generated JUCE project inputs required by that exporter.

.git
.github
.agents
.codex

assets
dist
build
build-*
cmake-build-*

Plugins/Builds/MacOSX
Plugins/Builds/iOS
Plugins/Builds/VisualStudio2026
Plugins/Builds/LinuxMakefile/build
Plugins/Builds/**/xcuserdata

# The Linux exporter needs these generated project inputs.
!Plugins/Builds/LinuxMakefile
!Plugins/Builds/LinuxMakefile/**
!Plugins/JuceLibraryCode
!Plugins/JuceLibraryCode/**
!3rdparty/JUCE
!3rdparty/JUCE/**
!3rdparty/R2JUCE
!3rdparty/R2JUCE/**

# Do not send host-generated Linux products back into the Docker build.
Plugins/Builds/LinuxMakefile/build
Plugins/Builds/LinuxMakefile/build/**
Plugins/Builds/LinuxMakefile/pre_build
Plugins/Builds/LinuxMakefile/pre_build/**

test
tools

*.bin
*.BIN
*.rom
*.ROM
